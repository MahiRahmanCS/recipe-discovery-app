# Copy this file to .env and fill in the values. Never commit .env.
NODE_ENV=development
PORT=3000

# Optional. Defaults to database/grubhub.db
DB_PATH=

# At least 32 random characters. Generate one with:
# node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
SESSION_SECRET=

# Sites allowed to send POST, PATCH and DELETE requests (comma-separated)
APP_ORIGINS=http://localhost:5173,http://localhost:3000
